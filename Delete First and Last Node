class ListNode:
    def __init__(self, val=0, next=None):
        self.val = val
        self.next = next

head = ListNode(1)
head.next = ListNode(2)
head.next.next = ListNode(3)
head.next.next.next = ListNode(4)
head.next.next.next.next = ListNode(5)

#Delete first node
if head:
  head = head.next

#Delete last node
curr = head
while curr.next.next:
  curr = curr.next
curr.next = None

curr = head
while curr:
  print(curr.val, end = " -> ")
  curr = curr.next
print(None)
