class ListNode:
  def __init__(self, val = 0, next = None):
    self.val = val
    self.next = next

#Create Linked List
head = ListNode(1)
head.next = ListNode(2)
head.next.next = ListNode(3)
head.next.next.next = ListNode(4)
head.next.next.next.next = ListNode(7)

#Print Linked List
while head:
  print(head.val, end = " -> ")
  head = head.next
print("None")
